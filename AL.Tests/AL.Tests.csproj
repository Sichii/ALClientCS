<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AL.Client\AL.Client.csproj"/>
        <ProjectReference Include="..\AL.Visualizer\AL.Visualizer.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="7.2.2"/>
        <!-- No Microsoft.NET.Test.Sdk: TUnit runs on Microsoft.Testing.Platform, and the VSTest SDK
             suppresses TUnit's generated entry point and breaks discovery if present. -->
        <PackageReference Include="TUnit" Version="1.61.38"/>
        <!-- No Newtonsoft.Json, deliberately. The characterization suite pinned its behaviour as the migration
             target and that job is done: the committed snapshots under Fixtures/snapshots were frozen while
             Newtonsoft produced them, so they remain the oracle as plain text with no second engine needed.
             Its absence is what guarantees none creeps back - the compiler enforces that, where a test could
             only notice it. -->
    </ItemGroup>

    <ItemGroup>
        <None Update="TestCredentials.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- offline game-data snapshot, so characterisation tests pin exact values without a network call -->
        <None Include="..\AL.Core\data.json" Link="Fixtures\data.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- Every snapshot, not just *.json: the non-public-member census is a .txt and was silently absent from
             the output. Always, not PreserveNewest: a test that writes into the snapshot directory leaves a copy
             newer than the committed file, which PreserveNewest then refuses to restore - so the drift check keeps
             reading that stale write forever. Always makes the committed fixture win on every build. -->
        <None Update="Fixtures\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>