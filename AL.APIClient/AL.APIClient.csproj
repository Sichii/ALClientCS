<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>AL.APIClient</Title>
        <Description>API wrapper client for the ALClientCS project. An api wrapper client for the Adventure.Land web api.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AL.Core\AL.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- RestSharp arrived transitively via RestSharp.Serializers.NewtonsoftJson until Phase 6b; the
             serializer package is dead (AddStringBody bypasses it) but the client itself is still used. -->
        <PackageReference Include="RestSharp" Version="112.1.0"/>
    </ItemGroup>

</Project>
