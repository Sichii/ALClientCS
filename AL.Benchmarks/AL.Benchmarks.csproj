<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- AL.APIClient fetches the game data that GameData.Populate consumes, as AL.Visualizer does -->
        <ProjectReference Include="..\AL.APIClient\AL.APIClient.csproj"/>
        <ProjectReference Include="..\AL.Pathfinding\AL.Pathfinding.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8"/>
    </ItemGroup>

    <ItemGroup>
        <!-- the same route fixtures the pathfinding tests read -->
        <None Include="..\AL.Tests\Fixtures\pathfinding\old-paths.json" Link="Fixtures\old-paths.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\AL.Tests\Fixtures\pathfinding\blink-paths.json" Link="Fixtures\blink-paths.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
